{
  "name": "tomitrack",
  "version": "0.1.0",
  "description": "Your diecast collection, in focus. By TomiKing.",
  "author": "TomiKing",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check web/app/app.js && node --check web/app/domain.js && node --check desktop/main.cjs",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "prepare:android": "node scripts/prepare-android.mjs"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.tomiking.tomitrack",
    "productName": "TomiTrack",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "web/assets/icon.png",
      "artifactName": "TomiTrack-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
